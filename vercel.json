{
  "version": 2,
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/admin", "destination": "/api/index.js" },
    { "source": "/track/(.*)", "destination": "/api/index.js" },
    { "source": "/p/(.*)", "destination": "/api/index.js" }
  ]
}
