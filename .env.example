# Copy to .env and replace every secret/value before deployment.
PORT=3000
SESSION_SECRET=replace-with-a-cryptographically-random-secret-at-least-32-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-unique-password
TRUST_PROXY=0
# Official WhatsApp Business Cloud API credentials; leave blank for click-to-chat fallback.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=
# Pre-approved WhatsApp Business templates with body params: name, order number, package [plus rejection reason].
WHATSAPP_APPROVED_TEMPLATE=order_approved
WHATSAPP_REJECTED_TEMPLATE=order_rejected
WHATSAPP_TEMPLATE_LANGUAGE=en
