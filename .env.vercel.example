# Vercel deployment environment template. Add real values in Vercel Project Settings > Environment Variables.
# Do not commit actual credentials or secrets.

# Required application/admin settings
NODE_ENV=production
SESSION_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Neon PostgreSQL connection variables are injected by the connected Marketplace integration.
# Local development: `vercel env pull .env.local` (do not commit the resulting file).
DATABASE_URL=
POSTGRES_URL=

# Private Vercel Blob. Store connection provides BLOB_STORE_ID and VERCEL_OIDC_TOKEN automatically in Vercel deployments.
# A static write token is optional; use it only outside Vercel or if explicitly adding a token to the store connection.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
VERCEL_OIDC_TOKEN=

# Official WhatsApp Business Cloud API (optional until configured)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=
WHATSAPP_APPROVED_TEMPLATE=
WHATSAPP_REJECTED_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en

# Optional business/account settings
TRUST_PROXY=1
